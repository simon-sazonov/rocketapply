# ─── Search ───────────────────────────────────────────────
# Ordered fallback chain. Options: ddgs, serper, serpapi, searxng
SEARCH_PROVIDERS=ddgs,serper
SERPER_API_KEY=
SERPAPI_API_KEY=
SEARXNG_BASE_URL=http://localhost:8888

# ─── LLM ──────────────────────────────────────────────────
# Options: zai, deepseek, ollama
# `ollama` needs no API key at all — run scripts/setup_ollama.py once, then leave
# LLM_FALLBACK=none. Use `zai` (free tier, needs ZAI_API_KEY) if you would rather
# not spend minutes per batch on local CPU inference.
LLM_PROVIDER=ollama
LLM_FALLBACK=none

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

OLLAMA_BASE_URL=http://localhost:11434/v1
# Created by scripts/setup_ollama.py: qwen2.5:7b with num_ctx raised to 8192.
# A bare `qwen2.5:7b` would use Ollama's 4096 default and silently truncate.
OLLAMA_MODEL=pitwall-qwen2.5

# ─── Behaviour ────────────────────────────────────────────
DB_PATH=data/pitwall.db
CACHE_DIR=data/cache
CACHE_TTL_DAYS=7
MAX_QUERIES_PER_RUN=200
MAX_RESULTS_PER_QUERY=20
# see config/settings.yaml for how this value was tuned
HEURISTIC_THRESHOLD=12
LLM_BATCH_SIZE=8
DDGS_QUERIES_PER_SECOND=0.25
SERPER_QUERIES_PER_SECOND=5
DAILY_LLM_REQUEST_CAP=900
RETENTION_DAYS=180
LOG_LEVEL=INFO
