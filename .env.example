# PitWall — secrets and machine-specific choices. Copy to `.env`.
# Precedence: CLI flags > .env > config/settings.yaml > code defaults.
#
# Everything here is free. No entry in this file requires a credit card, and
# nothing converts to paid. If a provider changes that, drop it from its chain
# and the next one takes over.

# ─── Search ───────────────────────────────────────────────
# Ordered fallback chain. Options: searxng, ddgs, serper, serpapi
# A provider leaves the chain on its own terms: searxng when the container is
# not running, serper without a key or below its credit reserve.
SEARCH_PROVIDER_CHAIN=searxng,ddgs,serper

# Self-hosted, keyless, and the only provider that supports operators — `ddgs`
# does not, which is why v1 could only ever fire 4 of the 12 query templates.
#   make searxng          start it (writes docker/searxng/.env on first run)
#   make searxng-check    prove JSON and operator queries work
SEARXNG_BASE_URL=http://localhost:8888
# `;`-separated engine GROUPS, one per query, round-robin, so no single upstream
# engine absorbs the whole sweep. The names must be enabled on the instance —
# http://localhost:8888/config lists what yours has. Leave empty for an instance
# you do not control.
# SEARXNG_ENGINES=google,duckduckgo;bing,startpage;brave,mojeek,qwant

# 2,500 one-time credits that never refill. Optional; the chain works without it.
SERPER_API_KEY=
# The chain stops reaching for serper at or below this many credits, so a
# routine sweep cannot spend the burst capacity. `--use-serper` overrides it.
SERPER_RESERVE_CREDITS=500
SERPAPI_API_KEY=

# ─── LLM ──────────────────────────────────────────────────
# Ordered degradation path. Providers without a key are skipped silently, so
# leaving zai and deepseek empty costs nothing. v1's LLM_FALLBACK=none meant an
# unreachable provider halted the run; this replaces it.
# zai and deepseek removed 24 Sep 2026: both are paid and Simon is not using them.
# Groq's free tier does the cloud work; Ollama is the local fallback AND the
# independent auditor for the cover-letter fact check, which must not be the
# same model family that wrote the text.
LLM_PROVIDER_CHAIN=groq,ollama

# Groq: free tier, no credit card, ~30 requests/minute and 1,000/day, with an
# 8,000 tokens/minute ceiling that is the real pace limit. Key from
# https://console.groq.com — this is the single biggest speed win in v2.
GROQ_API_KEY=
# Optional extra keys for the SAME provider, used in parallel. Groq's free tier
# caps ONE key at 8,000 tokens a minute and 200,000 a day — about twenty letters.
# Each key you add multiplies both ceilings, and the router picks whichever key
# has the most room rather than taking turns: when one is refused it switches
# immediately instead of waiting. Leave them blank and nothing changes.
# `trace.jsonl` records which key answered, as a fingerprint like "...a1b2" —
# the key itself is never written anywhere.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Overrides the active provider's model. Empty = each provider's own default
# (groq: openai/gpt-oss-20b — fastest in the catalogue and one of the few that
# supports strict schema-constrained JSON). Groq retires model IDs on short
# notice, so verify before a long run:
#   make groq-check
LLM_MODEL=
# gpt-oss and Qwen3 on Groq emit a reasoning trace that is billed against the
# same token budget as the answer. This is a rubric-following classification
# task: none | low | medium | high
LLM_REASONING_EFFORT=low

# Permanent free tiers, both optional, both OpenAI-compatible.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Last resort, and last on purpose: local CPU inference is minutes per batch.
# Run scripts/setup_ollama.py once to create the model — a bare `qwen2.5:7b`
# would use Ollama's 4096-token default and silently truncate the rubric.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=pitwall-qwen2.5

# ─── Contact enrichment (v3) ──────────────────────────────
# PitWall's own free engine — domain resolution, address harvesting, pattern
# inference, corroboration search, MX and role checks — runs entirely without
# any key here. Everything below is optional.

# Hunter.io, free plan: 50 credits a month, no credit card, and it never
# converts to paid. Costs verified against help.hunter.io on 1 Sep 2026:
#   Email Finder   1 credit per call, charged ONLY if an address is found
#   Domain Search  1 credit per 1–10 addresses returned for that domain
#   Email Verifier 0.5 credits per call
#   Account        free
# Hunter is NEVER called automatically and never in bulk. It is a per-person
# button the owner clicks, one credit at a time. Key from https://hunter.io.
HUNTER_API_KEY=

# Optional. GitHub commit emails are public by design and are the single best
# source for software and simulation people (§2.4). Unauthenticated is 60
# requests/hour; a token with NO scopes at all raises that to 5,000.
GITHUB_TOKEN=

# §4: a pattern needs this many real addresses agreeing before a derived
# address may be called `probable` rather than `guess`. This is the number that
# decides whether you are shown a hypothesis dressed as a fact.
ENRICH_MIN_SAMPLES_FOR_PROBABLE=2

# ─── Job search ───────────────────────────────────────────
# Adzuna's search API — the job search's role-first, multi-country source.
# Free: register at https://developer.adzuna.com and copy the two values.
# Empty = Adzuna is skipped; ATS boards and Arbeitnow still run.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble's REST API: the United States. Free key from https://jooble.org/api/about;
# it works on jooble.org only, so it covers the US and nothing else.
JOOBLE_API_KEY_US=

# ITJobs.pt: Portugal's main IT board. Free read-only key, sent by email the moment
# you enter it at https://www.itjobs.pt/api
ITJOBS_API_KEY=

# Findwork: a small remote-heavy aggregator. Free key at https://findwork.dev/developers/
FINDWORK_API_KEY=

# ─── Company research for cover letters ───────────────────
# Fills the COMPANY NOTES slot that `profile/companies.yaml` leaves empty, from
# the employer's own pages. Nothing here writes to `profile/`, and nothing here
# runs while a letter is being written — generation reads a cache and makes no
# request. Everything is free: the search chain above plus Groq's free tier.
#
#   pitwall apply research Anthropic Helsing
#   pitwall apply research Meetdavis --dry-run   # what the model would see
#   pitwall apply research --show                # what is cached

# Days a company's research is trusted. Long, because what a company builds does
# not change monthly. 0 re-researches every time.
APPLY_RESEARCH_TTL_DAYS=90

# HOW MANY SEARCH RESULTS MUST NAME THE COMPANY BEFORE THE MODEL SEES ANY OF
# THEM. This is the number that prevents fabrication, and it was not chosen in
# the abstract: on a real run for a small employer the results came back as
# ResearchGate, academia.edu and a "must-read blogs" listicle, and the model read
# those and invented a research programme, cited ResearchGate for it, and
# reported high confidence. Below this count nothing is sent and the answer is an
# honest blank, which is what the letter does today anyway.
APPLY_RESEARCH_MIN_SOURCES=3

# Terms a sentence may assert that appear in no source. Zero, because a sentence
# naming something none of the sources name IS the fabrication. Raise to 1 only
# if `--show` proves it is killing good sentences.
APPLY_RESEARCH_MAX_UNGROUNDED_TERMS=0

# ─── Behaviour ────────────────────────────────────────────
DB_PATH=data/pitwall.db
CACHE_DIR=data/cache
CACHE_TTL_DAYS=7
MAX_QUERIES_PER_RUN=200
MAX_RESULTS_PER_QUERY=20
# See config/settings.yaml for how this was tuned, and why it has to be re-swept
# against SearXNG SERP shapes before it moves back towards the plan's 25.
HEURISTIC_THRESHOLD=12
LLM_BATCH_SIZE=8
SEARXNG_QUERIES_PER_SECOND=1
DDGS_QUERIES_PER_SECOND=0.25
SERPER_QUERIES_PER_SECOND=5
DAILY_LLM_REQUEST_CAP=900
RETENTION_DAYS=180
LOG_LEVEL=INFO
